  @@index([salesInvoiceId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([exchangeNumber])
  @@index([createdAt])
  @@map("customer_gold_exchanges")
  @@schema("public")
}

model CustomerGoldExchangeItem {
  id               String               @id @default(uuid()) @db.Uuid
  exchangeId       String               @map("exchange_id") @db.Uuid
  exchange         CustomerGoldExchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  metalType        MetalType            @map("metal_type")
  purity           String
  grossWeight      Decimal              @map("gross_weight") @db.Decimal(12, 3)
  stoneWeight      Decimal              @default(0.000) @map("stone_weight") @db.Decimal(12, 3)
  netWeight        Decimal              @map("net_weight") @db.Decimal(12, 3)
  metalRateId      String?              @map("metal_rate_id") @db.Uuid
  metalRate        MetalRate?           @relation(fields: [metalRateId], references: [id], onDelete: SetNull)
  ratePerGram      Decimal              @default(0.00) @map("rate_per_gram") @db.Decimal(12, 2)
  metalValue       Decimal              @default(0.00) @map("metal_value") @db.Decimal(12, 2)
  deductionPercent Decimal              @default(0.0000) @map("deduction_percent") @db.Decimal(8, 4)
  deductionAmount  Decimal              @default(0.00) @map("deduction_amount") @db.Decimal(12, 2)
  exchangeValue    Decimal              @default(0.00) @map("exchange_value") @db.Decimal(12, 2)
  remarks          String?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  @@index([exchangeId])
  @@index([metalRateId])
  @@index([metalType, purity])
  @@map("customer_gold_exchange_items")
  @@schema("public")
}

// ==========================================
// SPRINT 4.7 SALES RETURN & REFUND MODELS (Public Schema)
// ==========================================

enum SalesReturnStatus {
  REQUESTED
  APPROVED
  PROCESSED
  CANCELLED

  @@map("sales_return_status")
  @@schema("public")
}

model SalesReturn {
  id                 String            @id @default(uuid()) @db.Uuid
  returnNumber       String            @unique @map("return_number")
  salesInvoiceId     String            @map("sales_invoice_id") @db.Uuid
  salesInvoice       SalesInvoice      @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  customerId         String            @map("customer_id") @db.Uuid
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId           String            @map("branch_id") @db.Uuid
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status             SalesReturnStatus @default(REQUESTED)
  subtotal           Decimal           @default(0.00) @db.Decimal(12, 2)
  taxAmount          Decimal           @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  deductionAmount    Decimal           @default(0.00) @map("deduction_amount") @db.Decimal(12, 2)
  refundAmount       Decimal           @default(0.00) @map("refund_amount") @db.Decimal(12, 2)
  reason             String?
  remarks            String?
  requestedBy        String?           @map("requested_by") @db.Uuid
  approvedBy         String?           @map("approved_by") @db.Uuid
  processedBy        String?           @map("processed_by") @db.Uuid
  cancelledBy        String?           @map("cancelled_by") @db.Uuid
  approvedAt         DateTime?         @map("approved_at") @db.Timestamptz
  processedAt        DateTime?         @map("processed_at") @db.Timestamptz
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz
  cancellationReason String?           @map("cancellation_reason")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  items   SalesReturnItem[]
  refunds SalesRefund[]

  @@index([salesInvoiceId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@map("sales_returns")
  @@schema("public")
}

model SalesReturnItem {
  id                 String           @id @default(uuid()) @db.Uuid
  salesReturnId      String           @map("sales_return_id") @db.Uuid
  salesReturn        SalesReturn      @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  salesInvoiceItemId String           @map("sales_invoice_item_id") @db.Uuid
  salesInvoiceItem   SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id], onDelete: Restrict)
  inventoryItemId    String           @map("inventory_item_id") @db.Uuid
  inventoryItem      InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity           Int              @default(1)
  originalAmount     Decimal          @map("original_amount") @db.Decimal(12, 2)
  taxAmount          Decimal          @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  deductionAmount    Decimal          @default(0.00) @map("deduction_amount") @db.Decimal(12, 2)
  refundAmount       Decimal          @default(0.00) @map("refund_amount") @db.Decimal(12, 2)
  reason             String?
  remarks            String?
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@index([salesReturnId])
  @@index([salesInvoiceItemId])
  @@index([inventoryItemId])
  @@map("sales_return_items")
  @@schema("public")
}

enum RefundStatus {
  PENDING
  COMPLETED
  REVERSED

  @@map("refund_status")
  @@schema("public")
}

model SalesRefund {
  id                   String        @id @default(uuid()) @db.Uuid
  salesReturnId        String        @map("sales_return_id") @db.Uuid
  salesReturn          SalesReturn   @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  refundNumber         String        @unique @map("refund_number")
  refundMethod         PaymentMethod @map("refund_method")
  amount               Decimal       @db.Decimal(12, 2)
  status               RefundStatus  @default(COMPLETED)
  transactionReference String?       @map("transaction_reference")
  remarks              String?
  processedBy          String?       @map("processed_by") @db.Uuid
  reversedAt           DateTime?     @map("reversed_at") @db.Timestamptz
  reversedBy           String?       @map("reversed_by") @db.Uuid
  reversalReason       String?       @map("reversal_reason")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([salesReturnId])
  @@index([refundMethod])
  @@index([status])
  @@index([createdAt])
  @@map("sales_refunds")
  @@schema("public")
}

