  customerId           String         @map("customer_id") @db.Uuid
  customer             Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId             String         @map("branch_id") @db.Uuid
  branch               Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status               ExchangeStatus @default(REQUESTED)
  totalGrossWeight     Decimal        @default(0.000) @map("total_gross_weight") @db.Decimal(12, 3)
  totalStoneWeight     Decimal        @default(0.000) @map("total_stone_weight") @db.Decimal(12, 3)
  totalNetWeight       Decimal        @default(0.000) @map("total_net_weight") @db.Decimal(12, 3)
  totalMetalValue      Decimal        @default(0.00) @map("total_metal_value") @db.Decimal(12, 2)
  totalDeductionAmount Decimal        @default(0.00) @map("total_deduction_amount") @db.Decimal(12, 2)
  totalExchangeValue   Decimal        @default(0.00) @map("total_exchange_value") @db.Decimal(12, 2)
  remarks              String?
