enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE

  @@map("payment_method")
  @@schema("public")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED

  @@map("payment_status")
  @@schema("public")
}

model SalesPayment {
  id                   String        @id @default(uuid()) @db.Uuid
  salesInvoiceId       String        @map("sales_invoice_id") @db.Uuid
  salesInvoice         SalesInvoice  @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
