// Prisma schema for Jewellery ERP (PostgreSQL with multiSchema IAM and Public support)

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["iam", "public"]
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  displayName     String           @map("display_name")
  description     String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
  @@schema("iam")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  module          String
  action          String
  permissionKey   String           @unique @map("permission_key")
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("iam")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("iam")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  roleId              String               @map("role_id") @db.Uuid
  role                Role                 @relation(fields: [roleId], references: [id])
  employeeId          String?              @unique @map("employee_id") @db.Uuid
  employee            Employee?            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  firstName           String               @map("first_name")
  lastName            String?              @map("last_name")
  email               String               @unique
  mobile              String?
  passwordHash        String               @map("password_hash")
  avatarUrl           String?              @map("avatar_url")
  status              String               @default("ACTIVE")
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamptz
  createdBy           String?              @map("created_by") @db.Uuid
  updatedBy           String?              @map("updated_by") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  sessions            UserSession[]
  loginHistories      LoginHistory[]
  passwordResetTokens PasswordResetToken[]
  requestedTransfers  InventoryTransfer[]  @relation("TransferRequestedBy")
  approvedTransfers   InventoryTransfer[]  @relation("TransferApprovedBy")
  dispatchedTransfers InventoryTransfer[]  @relation("TransferDispatchedBy")
  receivedTransfers   InventoryTransfer[]  @relation("TransferReceivedBy")
  rejectedTransfers   InventoryTransfer[]  @relation("TransferRejectedBy")
  createdInvoices     SalesInvoice[]       @relation("InvoiceCreatedByUser")
  updatedInvoices     SalesInvoice[]       @relation("InvoiceUpdatedByUser")

  @@map("users")
  @@schema("iam")
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique @map("refresh_token")
  device       String?
  browser      String?
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("user_sessions")
  @@schema("iam")
}

model LoginHistory {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt   DateTime  @default(now()) @map("login_at") @db.Timestamptz
  logoutAt  DateTime? @map("logout_at") @db.Timestamptz
  ipAddress String?   @map("ip_address")
  device    String?
  browser   String?
  status    String    @default("SUCCESS")

  @@map("login_history")
  @@schema("iam")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("password_reset_tokens")
  @@schema("iam")
}

// ==========================================
// PHASE 2 MASTER MODELS (Public Schema)
// ==========================================

model Company {
  id                   String               @id @default(uuid()) @db.Uuid
  companyCode          String               @unique @map("company_code")
  name                 String
  legalName            String?              @map("legal_name")
  gstNumber            String?              @unique @map("gst_number")
  panNumber            String?              @unique @map("pan_number")
  email                String?
  phone                String?
  website              String?
  logoUrl              String?              @map("logo_url")
  isActive             Boolean              @default(true) @map("is_active")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  branches             Branch[]
  employees            Employee[]
  customers            Customer[]
  vendors              Vendor[]
  productCategories    ProductCategory[]
  productSubCategories ProductSubCategory[]
  products             Product[]
  inventoryItems       InventoryItem[]
  metalRates           MetalRate[]
  makingCharges        MakingCharge[]
  taxRates             TaxRate[]
  financialYears       FinancialYear[]
  documentSeries       DocumentSeries[]
  jobWorkOrders        JobWorkOrder[]
  stockAuditSessions   StockAuditSession[]
  girviLoans           GirviLoan[]
  thirdPartyLenders    ThirdPartyLender[]
  thirdPartyGirvis     ThirdPartyGirvi[]
  approvals            Approval[]
  approvalDeposits     ApprovalDeposit[]

  @@map("companies")
  @@schema("public")
}

model Branch {
  id                  String                     @id @default(uuid()) @db.Uuid
  companyId           String                     @map("company_id") @db.Uuid
  company             Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchCode          String                     @map("branch_code")
  name                String
  email               String?
  phone               String?
  addressLine1        String?                    @map("address_line1")
  addressLine2        String?                    @map("address_line2")
  city                String?
  state               String?
  pincode             String?
  isMainBranch        Boolean                    @default(false) @map("is_main_branch")
  isActive            Boolean                    @default(true) @map("is_active")
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  employees           EmployeeBranchAssignment[]
  customers           Customer[]
  vendors             Vendor[]
  inventoryItems      InventoryItem[]
  fromBranchMovements StockMovement[]            @relation("FromBranchMovements")
  toBranchMovements   StockMovement[]            @relation("ToBranchMovements")
  stockAdjustments    StockAdjustment[]
  fromBranchTransfers InventoryTransfer[]        @relation("TransferFromBranch")
  toBranchTransfers   InventoryTransfer[]        @relation("TransferToBranch")
  salesInvoices       SalesInvoice[]
  goldExchanges       CustomerGoldExchange[]
  salesReturns        SalesReturn[]
  purchaseOrders      PurchaseOrder[]
  purchaseBills       PurchaseBill[]
  vendorPayments      VendorPayment[]
  purchaseReturns     PurchaseReturn[]
  vendorDebitNotes    VendorDebitNote[]
  documentSeries      DocumentSeries[]
  jobWorkOrders       JobWorkOrder[]
  stockAuditSessions  StockAuditSession[]
  girviLoans          GirviLoan[]
  thirdPartyLenders   ThirdPartyLender[]
  thirdPartyGirvis    ThirdPartyGirvi[]
  approvals           Approval[]
  approvalDeposits    ApprovalDeposit[]

  @@unique([companyId, branchCode])
  @@map("branches")
  @@schema("public")
}

model Employee {
  id                String                     @id @default(uuid()) @db.Uuid
  companyId         String                     @map("company_id") @db.Uuid
  company           Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeCode      String                     @map("employee_code")
  firstName         String                     @map("first_name")
  lastName          String?                    @map("last_name")
  email             String?                    @unique
  mobile            String                     @unique
  joiningDate       DateTime?                  @map("joining_date") @db.Timestamptz
  isActive          Boolean                    @default(true) @map("is_active")
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  user              User?
  salesInvoices     SalesInvoice[]
  branchAssignments EmployeeBranchAssignment[]
  approvals         Approval[]

  @@unique([companyId, employeeCode])
  @@map("employees")
  @@schema("public")
}

model Customer {
  id                String                 @id @default(uuid()) @db.Uuid
  companyId         String                 @map("company_id") @db.Uuid
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId          String?                @map("branch_id") @db.Uuid
  branch            Branch?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerCode      String                 @map("customer_code")
  firstName         String                 @map("first_name")
  lastName          String?                @map("last_name")
  email             String?
  mobile            String                 @unique
  panNumber         String?                @map("pan_number")
  aadharNumber      String?                @map("aadhar_number")
  gstNumber         String?                @map("gst_number")
  customerType      String                 @default("RETAIL") @map("customer_type")
  openingCashBalance Decimal?              @default(0.00) @map("opening_cash_balance") @db.Decimal(15, 2)
  openingGoldBalanceGrams Decimal?        @default(0.000) @map("opening_gold_balance_grams") @db.Decimal(12, 3)
  openingSilverBalanceGrams Decimal?      @default(0.000) @map("opening_silver_balance_grams") @db.Decimal(12, 3)
  cashBalance             Decimal?        @default(0.00) @map("cash_balance") @db.Decimal(15, 2)
  goldBalanceGrams        Decimal?        @default(0.000) @map("gold_balance_grams") @db.Decimal(12, 3)
  silverBalanceGrams      Decimal?        @default(0.000) @map("silver_balance_grams") @db.Decimal(12, 3)
  isActive          Boolean                @default(true) @map("is_active")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  customerAddresses CustomerAddress[]
  customerDocuments CustomerDocument[]
  salesInvoices     SalesInvoice[]
  goldExchanges     CustomerGoldExchange[]
  salesReturns      SalesReturn[]
  girviLoans        GirviLoan[]
  thirdPartyGirvis  ThirdPartyGirvi[]
  approvals         Approval[]
  approvalDeposits  ApprovalDeposit[]

  @@unique([companyId, customerCode])
  @@map("customers")
  @@schema("public")
}

model CustomerAddress {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressType  String   @default("HOME") @map("address_type")
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  state        String
  pincode      String
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("customer_addresses")
  @@schema("public")
}

model CustomerDocument {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  documentType   String   @map("document_type")
  documentNumber String?  @map("document_number")
  fileUrl        String   @map("file_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("customer_documents")
  @@schema("public")
}

model Vendor {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId       String?         @map("branch_id") @db.Uuid
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  vendorCode     String          @map("vendor_code")
  companyName    String          @map("company_name")
  contactPerson  String?         @map("contact_person")
  email          String?
  mobile         String
  gstNumber      String?         @unique @map("gst_number")
  panNumber      String?         @map("pan_number")
  addressLine1   String?         @map("address_line1")
  city           String?
  state          String?
  pincode        String?
  vendorType     String          @default("JEWELLERY") @map("vendor_type")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  purchaseOrders PurchaseOrder[]
  purchaseBills  PurchaseBill[]
  vendorPayments VendorPayment[]
  purchaseReturns PurchaseReturn[]
  vendorDebitNotes VendorDebitNote[]
  jobWorkOrders  JobWorkOrder[]

  @@unique([companyId, vendorCode])
  @@map("vendors")
  @@schema("public")
}

model ProductCategory {
  id                   String               @id @default(uuid()) @db.Uuid
  companyId            String               @map("company_id") @db.Uuid
  company              Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name                 String
  code                 String               @map("code")
  description          String?
  isActive             Boolean              @default(true) @map("is_active")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  productSubCategories ProductSubCategory[]
  stockAuditSessions   StockAuditSession[]

  @@unique([companyId, code])
  @@map("product_categories")
  @@schema("public")
}

model ProductSubCategory {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  categoryId  String          @map("category_id") @db.Uuid
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  code        String          @map("code")
  description String?
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  products    Product[]

  @@unique([companyId, code])
  @@map("product_sub_categories")
  @@schema("public")
}

model Product {
  id            String             @id @default(uuid()) @db.Uuid
  companyId     String             @map("company_id") @db.Uuid
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subCategoryId String             @map("sub_category_id") @db.Uuid
  subCategory   ProductSubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  sku           String             @map("sku")
  name          String
  description   String?
  metalType     String             @default("GOLD") @map("metal_type")
  purity        String             @default("22K")
  grossWeight   Decimal            @default(0.00) @map("gross_weight") @db.Decimal(10, 3)
  netWeight     Decimal            @default(0.00) @map("net_weight") @db.Decimal(10, 3)
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  inventoryItems       InventoryItem[]
  images               ProductImage[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]

  @@unique([companyId, sku])
  @@map("products")
  @@schema("public")
}

// ==========================================
// PHASE 3 INVENTORY MODELS (Public Schema)
// ==========================================

model InventoryItem {
  id                    String               @id @default(uuid()) @db.Uuid
  companyId             String               @map("company_id") @db.Uuid
  company               Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productId             String               @map("product_id") @db.Uuid
  product               Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  branchId              String               @map("branch_id") @db.Uuid
  branch                Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchaseReceiptItemId String?              @map("purchase_receipt_item_id") @db.Uuid
  purchaseReceiptItem   PurchaseReceiptItem? @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: Restrict)
  itemCode              String               @map("item_code")
  grossWeight           Decimal              @map("gross_weight") @db.Decimal(12, 3)
  netWeight             Decimal              @map("net_weight") @db.Decimal(12, 3)
  stoneWeight           Decimal              @default(0.000) @map("stone_weight") @db.Decimal(12, 3)
  fineWeight            Decimal              @map("fine_weight") @db.Decimal(12, 3)
  purity                String
  status                String               @default("AVAILABLE")
  createdBy             String?              @map("created_by") @db.Uuid
  updatedBy             String?              @map("updated_by") @db.Uuid
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  tags                  InventoryTag[]
  images                InventoryItemImage[]
  stockMovements        StockMovement[]
  stockAdjustments      StockAdjustment[]
  transfers             InventoryTransfer[]
  salesInvoiceItems     SalesInvoiceItem[]
  salesReturnItems      SalesReturnItem[]
  purchaseBillItems     PurchaseBillItem[]
  purchaseReturnItems   PurchaseReturnItem[]
  jobWorkMaterialIssues JobWorkMaterialIssue[]
  jobWorkReceipts       JobWorkReceipt[]
  stockAuditItems       StockAuditItem[]
  girviCollaterals      GirviCollateral[]
  thirdPartyCollaterals ThirdPartyGirviCollateral[]
  approvalItems         ApprovalItem[]

  @@unique([companyId, itemCode])
  @@index([productId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@map("inventory_items")
  @@schema("public")
}

model InventoryTag {
  id              String        @id @default(uuid()) @db.Uuid
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  barcode         String        @unique
  rfidEpc         String?       @unique @map("rfid_epc")
  isActive        Boolean       @default(true) @map("is_active")
  taggedAt        DateTime      @default(now()) @map("tagged_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([inventoryItemId])
  @@map("inventory_tags")
  @@schema("public")
}

model StockMovement {
  id              String        @id @default(uuid()) @db.Uuid
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  fromBranchId    String?       @map("from_branch_id") @db.Uuid
  fromBranch      Branch?       @relation("FromBranchMovements", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranchId      String?       @map("to_branch_id") @db.Uuid
  toBranch        Branch?       @relation("ToBranchMovements", fields: [toBranchId], references: [id], onDelete: SetNull)
  movementType    String        @map("movement_type")
  referenceType   String?       @map("reference_type")
  referenceId     String?       @map("reference_id")
  remarks         String?
  performedBy     String?       @map("performed_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([inventoryItemId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([movementType])
  @@index([createdAt])
  @@map("stock_movements")
  @@schema("public")
}

model StockAdjustment {
  id                  String        @id @default(uuid()) @db.Uuid
  inventoryItemId     String        @map("inventory_item_id") @db.Uuid
  inventoryItem       InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  branchId            String        @map("branch_id") @db.Uuid
  branch              Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  previousStatus      String        @map("previous_status")
  newStatus           String        @map("new_status")
  previousGrossWeight Decimal       @map("previous_gross_weight") @db.Decimal(10, 3)
  newGrossWeight      Decimal       @map("new_gross_weight") @db.Decimal(10, 3)
  previousNetWeight   Decimal       @map("previous_net_weight") @db.Decimal(10, 3)
  newNetWeight        Decimal       @map("new_net_weight") @db.Decimal(10, 3)
  reason              String
  adjustedBy          String?       @map("adjusted_by") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([inventoryItemId])
  @@index([branchId])
  @@index([createdAt])
  @@map("stock_adjustments")
  @@schema("public")
}

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  DISPATCHED
  RECEIVED
  CANCELLED

  @@map("transfer_status")
  @@schema("public")
}

model InventoryTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  transferCode    String         @unique @map("transfer_code")
  inventoryItemId String         @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  fromBranchId    String         @map("from_branch_id") @db.Uuid
  fromBranch      Branch         @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranchId      String         @map("to_branch_id") @db.Uuid
  toBranch        Branch         @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)
  status          TransferStatus @default(REQUESTED)

  requestedBy     String @map("requested_by") @db.Uuid
  requestedByUser User   @relation("TransferRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)

  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedByUser User?     @relation("TransferApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz

  dispatchedBy     String?   @map("dispatched_by") @db.Uuid
  dispatchedByUser User?     @relation("TransferDispatchedBy", fields: [dispatchedBy], references: [id], onDelete: Restrict)
  dispatchedAt     DateTime? @map("dispatched_at") @db.Timestamptz

  receivedBy     String?   @map("received_by") @db.Uuid
  receivedByUser User?     @relation("TransferReceivedBy", fields: [receivedBy], references: [id], onDelete: Restrict)
  receivedAt     DateTime? @map("received_at") @db.Timestamptz

  rejectedBy      String?   @map("rejected_by") @db.Uuid
  rejectedByUser  User?     @relation("TransferRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict)
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz
  rejectionReason String?   @map("rejection_reason")

  remarks   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([inventoryItemId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([createdAt])
  @@map("inventory_transfers")
  @@schema("public")
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
