model ApprovalDeposit {
  id                   String        @id @default(uuid()) @db.Uuid
  approvalId           String        @map("approval_id") @db.Uuid
  approval             Approval      @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  companyId            String        @map("company_id") @db.Uuid
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId             String        @map("branch_id") @db.Uuid
  branch               Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId           String        @map("customer_id") @db.Uuid
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  depositNumber        String        @unique @map("deposit_number")
  paymentMethod        PaymentMethod @map("payment_method")
  amount               Decimal       @db.Decimal(12, 2)
  status               PaymentStatus @default(COMPLETED)
  transactionReference String?       @map("transaction_reference")
  paymentDate          DateTime      @default(now()) @map("payment_date") @db.Timestamptz
  remarks              String?
  receivedBy           String?       @map("received_by") @db.Uuid
  reversedAt           DateTime?     @map("reversed_at") @db.Timestamptz
  reversedBy           String?       @map("reversed_by") @db.Uuid
  reversalReason       String?       @map("reversal_reason")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([companyId, depositNumber])
  @@index([approvalId])
  @@index([companyId])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([paymentMethod])
  @@index([paymentDate])
  @@map("approval_deposits")
  @@schema("public")
}




