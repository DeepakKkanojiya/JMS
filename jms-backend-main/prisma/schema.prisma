  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([salesInvoiceId])
  @@index([paymentMethod])
  @@index([status])
  @@index([paymentDate])
  @@index([transactionReference])
  @@map("sales_payments")
  @@schema("public")
}

