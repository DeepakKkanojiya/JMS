// ==========================================
// PHASE 4 SALES MANAGEMENT MODELS (Public Schema)
// ==========================================

enum SalesInvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED

  @@map("sales_invoice_status")
  @@schema("public")
}

model SalesInvoice {
  id                  String             @id @default(uuid()) @db.Uuid
  invoiceNumber       String             @unique @map("invoice_number")
  customerId          String             @map("customer_id") @db.Uuid
  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId            String             @map("branch_id") @db.Uuid
  branch              Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  salespersonId       String?            @map("salesperson_id") @db.Uuid
  salesperson         Employee?          @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  status              SalesInvoiceStatus @default(DRAFT)
  invoiceDate         DateTime           @default(now()) @map("invoice_date") @db.Timestamptz
  subtotal            Decimal            @default(0.00) @map("subtotal") @db.Decimal(12, 2)
  metalValue          Decimal            @default(0.00) @map("metal_value") @db.Decimal(12, 2)
  wastageValue        Decimal            @default(0.00) @map("wastage_value") @db.Decimal(12, 2)
  makingCharges       Decimal            @default(0.00) @map("making_charges") @db.Decimal(12, 2)
  taxableAmount       Decimal            @default(0.00) @map("taxable_amount") @db.Decimal(12, 2)
  discountAmount      Decimal            @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  cgstAmount          Decimal            @default(0.00) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount          Decimal            @default(0.00) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount          Decimal            @default(0.00) @map("igst_amount") @db.Decimal(12, 2)
  taxAmount           Decimal            @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  grandTotal          Decimal            @default(0.00) @map("grand_total") @db.Decimal(12, 2)
  pricingCalculated   Boolean            @default(false) @map("pricing_calculated")
  pricingCalculatedAt DateTime?          @map("pricing_calculated_at") @db.Timestamptz
  notes               String?
  createdByUserId     String?            @map("created_by_user_id") @db.Uuid
  createdByUser       User?              @relation("InvoiceCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId     String?            @map("updated_by_user_id") @db.Uuid
  updatedByUser       User?              @relation("InvoiceUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  metalRateLocked     Boolean            @default(false) @map("metal_rate_locked")
  metalRateLockedAt   DateTime?          @map("metal_rate_locked_at") @db.Timestamptz
  totalPaid           Decimal            @default(0.00) @map("total_paid") @db.Decimal(12, 2)
  outstandingAmount   Decimal            @default(0.00) @map("outstanding_amount") @db.Decimal(12, 2)
  paymentStatus       String             @default("UNPAID") @map("payment_status")
  exchangeCredit      Decimal            @default(0.00) @map("exchange_credit") @db.Decimal(12, 2)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // Confirmation legal snapshots
  companyNameSnapshot     String? @map("company_name_snapshot")
  companyGstSnapshot      String? @map("company_gst_snapshot")
  companyAddressSnapshot  String? @map("company_address_snapshot")
  branchNameSnapshot      String? @map("branch_name_snapshot")
  branchAddressSnapshot   String? @map("branch_address_snapshot")
  customerNameSnapshot    String? @map("customer_name_snapshot")
  customerMobileSnapshot  String? @map("customer_mobile_snapshot")
  customerAddressSnapshot String? @map("customer_address_snapshot")
  customerGstSnapshot     String? @map("customer_gst_snapshot")

  items             SalesInvoiceItem[]
  metalRateSnapshot SalesInvoiceMetalRate?
  payments          SalesPayment[]
  goldExchanges     CustomerGoldExchange[]
  salesReturns      SalesReturn[]

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([invoiceDate])
  @@map("sales_invoices")
  @@schema("public")
}

model SalesInvoiceItem {
  id                 String            @id @default(uuid()) @db.Uuid
  salesInvoiceId     String            @map("sales_invoice_id") @db.Uuid
  salesInvoice       SalesInvoice      @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  inventoryItemId    String            @map("inventory_item_id") @db.Uuid
  inventoryItem      InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  salesReturnItems   SalesReturnItem[]
  quantity           Int               @default(1)
  unitPrice          Decimal           @map("unit_price") @db.Decimal(12, 2)
  metalValue         Decimal           @default(0.00) @map("metal_value") @db.Decimal(12, 2)
  wastagePercent     Decimal           @default(0.00) @map("wastage_percent") @db.Decimal(5, 2)
  wastageWeight      Decimal           @default(0.000) @map("wastage_weight") @db.Decimal(12, 3)
  wastageValue       Decimal           @default(0.00) @map("wastage_value") @db.Decimal(12, 2)
  makingChargeType   MakingChargeType? @map("making_charge_type")
  makingChargeRate   Decimal           @default(0.00) @map("making_charge_rate") @db.Decimal(12, 2)
  makingChargeAmount Decimal           @default(0.00) @map("making_charge_amount") @db.Decimal(12, 2)
  taxableAmount      Decimal           @default(0.00) @map("taxable_amount") @db.Decimal(12, 2)
  taxRate            Decimal           @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  discountAmount     Decimal           @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount          Decimal           @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal          Decimal           @map("line_total") @db.Decimal(12, 2)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  // Confirmation item snapshots
  productNameSnapshot String?  @map("product_name_snapshot")
  productSkuSnapshot  String?  @map("product_sku_snapshot")
  metalTypeSnapshot   String?  @map("metal_type_snapshot")
  puritySnapshot      String?  @map("purity_snapshot")
  grossWeightSnapshot Decimal? @map("gross_weight_snapshot") @db.Decimal(12, 3)
  netWeightSnapshot   Decimal? @map("net_weight_snapshot") @db.Decimal(12, 3)
  stoneWeightSnapshot Decimal? @map("stone_weight_snapshot") @db.Decimal(12, 3)
  fineWeightSnapshot  Decimal? @map("fine_weight_snapshot") @db.Decimal(12, 3)

  @@index([salesInvoiceId])
  @@index([inventoryItemId])
  @@map("sales_invoice_items")
  @@schema("public")
}

// ==========================================
// SPRINT 4.4 PRICING & TAX MODELS (Public Schema)
// ==========================================

enum MakingChargeType {
  PER_GRAM
  FIXED
  PERCENTAGE

  @@map("making_charge_type")
  @@schema("public")
}

model MakingCharge {
