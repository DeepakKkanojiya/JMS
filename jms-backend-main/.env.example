# Server Port & Environment
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:admin@localhost:5432/jewellery_erp?schema=iam

# JWT Authentication Secrets & Expirations
JWT_SECRET=super_secret_jwt_key_jewellery_erp_2026_change_in_production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_jewellery_erp_2026
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SWAGGER_ENABLED=true

# Frontend Development Credentials (Placeholders only - Never commit real secrets)
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=